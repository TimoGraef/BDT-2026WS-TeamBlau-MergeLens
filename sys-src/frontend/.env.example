# Base URL of the MergeLens inference service (FastAPI)
VITE_INFERENCE_API_URL=http://localhost:8000

# Inference mode: "live" calls VITE_INFERENCE_API_URL, "mock" uses the local demo evaluator
VITE_INFERENCE_MODE=mock

# Optional custom GitHub API base URL (defaults to https://api.github.com)
VITE_GITHUB_API_URL=https://api.github.com
